COMPOSE_PROJECT_NAME=devedu

POSTGRES_DB=devedu
POSTGRES_USER=devedu
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

BACKEND_PORT=8080
FRONTEND_PORT=5173

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=P7D

# Tài khoản quản trị được tạo một lần khi backend khởi động.
# Đặt password mạnh, 8-72 UTF-8 byte; không commit file .env.
ADMIN_NAME=DevEdu Admin
ADMIN_EMAIL=admin@devedu.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# OAuth apps. Redirect URIs:
# http://localhost:5173/login/oauth2/code/google
# http://localhost:5173/login/oauth2/code/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP gửi mã xác nhận email 6 chữ số. Với Gmail, dùng App Password thay vì
# mật khẩu tài khoản thông thường và đặt MAIL_FROM trùng MAIL_USERNAME.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
EMAIL_VERIFICATION_TTL=PT10M
EMAIL_VERIFICATION_RESEND_COOLDOWN=PT1M
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Gemini chỉ được gọi từ backend để tạo bản nháp bài tập. Không đưa key xuống frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=PT45S
GEMINI_SUGGESTION_TIMEOUT=PT8S

# Docker Desktop: 0. Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
