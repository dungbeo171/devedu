COMPOSE_PROJECT_NAME=devedu

POSTGRES_DB=devedu
POSTGRES_USER=devedu
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

BACKEND_PORT=8080
FRONTEND_PORT=5173

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=P7D

# Tài khoản quản trị được tạo một lần khi backend khởi động.
# Đặt password mạnh, 8-72 UTF-8 byte; không commit file .env.
ADMIN_NAME=DevEdu Admin
ADMIN_EMAIL=admin@devedu.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# OAuth apps. Redirect URIs:
# http://localhost:5173/login/oauth2/code/google
# http://localhost:5173/login/oauth2/code/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Docker Desktop: 0. Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
